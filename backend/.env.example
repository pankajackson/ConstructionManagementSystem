# ==== Core (required) ====
MONGO_URL="mongodb://localhost:27017"
DB_NAME="constructos_db"
JWT_SECRET="<generate a 64+ char random string>"
ACCESS_TOKEN_MINUTES="480"
REFRESH_TOKEN_DAYS="30"

# ==== OTP behavior ====
OTP_EXPIRY_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_RATE_LIMIT_PER_HOUR="10"

# ==== Dev switch ====
# When true and OTP_DELIVERY_TYPE=console, the API response body includes dev_otp
# so the frontend can auto-fill. Always false in production.
DEV_MODE="true"
FRONTEND_URL="http://localhost:3000"
# Public URL of THIS backend, used to build absolute file URLs returned by the
# filesystem storage provider. Set this to your public backend host in production
# so the URLs returned in uploads/logs/issues are reachable from any client.
PUBLIC_BASE_URL=""

# ==== OTP delivery provider (pluggable) ====
# console  -> logs OTP to server console; ideal for dev.
# sendgrid -> sends a real HTML email via SendGrid; requires the 3 keys below.
OTP_DELIVERY_TYPE="console"
SENDGRID_API_KEY=""              # required if OTP_DELIVERY_TYPE=sendgrid
SENDGRID_FROM_EMAIL=""           # required if OTP_DELIVERY_TYPE=sendgrid — must be VERIFIED in SendGrid
SENDGRID_FROM_NAME="ConstructOS" # optional display name

# ==== File storage provider (pluggable) ====
# filesystem -> local disk under UPLOAD_DIR; served by backend.
# s3         -> uploads to a PRIVATE S3 bucket, returns pre-signed URLs by default.
STORAGE_TYPE="filesystem"
UPLOAD_DIR="/app/backend/uploads"
AWS_ACCESS_KEY_ID=""             # required if STORAGE_TYPE=s3
AWS_SECRET_ACCESS_KEY=""         # required if STORAGE_TYPE=s3
AWS_S3_BUCKET=""                 # required if STORAGE_TYPE=s3
AWS_S3_REGION="ap-south-1"       # required if STORAGE_TYPE=s3 — Mumbai for low India latency
# Optional: if you front the bucket with CloudFront (or make it public), set this to the CDN base URL.
# If left empty, S3Provider returns pre-signed GET URLs.
AWS_S3_PUBLIC_URL_BASE=""
# Pre-signed URL lifetime in seconds. Default 7 days (S3 max for SigV4).
S3_PRESIGNED_TTL_SECONDS="604800"
