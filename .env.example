# =========================================================================
# ConstructOS — root env for docker-compose
# Copy to .env before running `docker compose up`.
# All values below are safe DEV defaults — the app will run out of the box.
# =========================================================================

# ---- Ports on your host machine ----
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3000
MONGO_HOST_PORT=27017

# ---- Backend core ----
DB_NAME=constructos_db
# CHANGE this to a long random string in production.
JWT_SECRET=8e1c9a2b7f4d3e6a5b8c7d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=30

# ---- OTP behavior ----
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=10
# When true and OTP_DELIVERY_TYPE=console, the /auth/request-otp response
# includes the OTP so the login screen can auto-fill it. Turn OFF in prod.
DEV_MODE=true

# ---- URLs used by the backend ----
FRONTEND_URL=http://localhost:3000
# The public URL clients use to reach the backend. Used to build absolute
# file URLs (photo attachments) that render in <img> tags. For plain local
# Docker on your laptop, `http://localhost:8001` is correct.
PUBLIC_BASE_URL=http://localhost:8001

# =========================================================================
# OTP delivery — pluggable provider
# =========================================================================
# console  -> logs OTP to backend stdout; also returns it in the response
#             body when DEV_MODE=true. Perfect for dev.
# sendgrid -> sends a real HTML email via SendGrid; requires the 3 keys below.
OTP_DELIVERY_TYPE=console
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=ConstructOS

# =========================================================================
# File storage — pluggable provider
# =========================================================================
# filesystem -> local disk under /app/uploads (persisted via `backend_uploads` volume).
# s3         -> uploads to a private S3 bucket, returns pre-signed GET URLs.
STORAGE_TYPE=filesystem
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
# Optional — if you put CloudFront in front of the bucket, set this to the CDN URL.
# When empty, the backend returns pre-signed URLs instead of a public URL.
AWS_S3_PUBLIC_URL_BASE=
# Pre-signed URL lifetime. Default 7 days (S3 SigV4 maximum).
S3_PRESIGNED_TTL_SECONDS=604800

# =========================================================================
# Frontend
# =========================================================================
REACT_APP_BACKEND_URL=http://localhost:8001
